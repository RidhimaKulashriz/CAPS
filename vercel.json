{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "routes": [
    {
      "src": "/pmc-stream/0.mp4",
      "dest": "https://pmc.ncbi.nlm.nih.gov/articles/instance/12307736/bin/41746_2025_1890_MOESM2_ESM.mp4",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "referer" },
          "args": "https://pmc.ncbi.nlm.nih.gov/"
        },
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "user-agent" },
          "args": "Mozilla/5.0 (CaPS research media)"
        },
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "accept" },
          "args": "video/mp4,*/*"
        }
      ]
    },
